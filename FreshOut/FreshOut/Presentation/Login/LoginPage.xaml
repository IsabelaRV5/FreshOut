<Page x:Class="GUI.Presentation.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:GUI.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      Background="{ThemeResource BackgroundBrush}">

  <Page.Resources>
    <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

    <!-- LOGIN BUTTON : STYLE -->
    <Style x:Key="LoginButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialFilledButtonStyle}">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#475773" />
      <Setter Property="Background" Value="#aec4e8" />
    </Style>

    <!-- REGISTER BUTTON : STYLE -->
    <Style x:Key="RegisterButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialTextButtonStyle}">
      <Setter Property="Foreground" Value="#475773" />
    </Style>
  </Page.Resources>

  <Viewbox Stretch="Uniform">
    <ScrollViewer IsTabStop="True">
      <Grid utu:SafeArea.Insets="VisibleBounds"
            Width="1440"
            Height="810"
            Background="#aec4e8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <utu:NavigationBar Content="{Binding Title}"
                         Background="#475773"
                         Foreground="#fff8e8" />
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16"
                    Orientation="Horizontal">
          <StackPanel Width="550"
                      Height="710"
                      Background="#fffcf5"
                      VerticalAlignment="Center"
                      Padding="30">
              
              <!-- TITLE -->
              <TextBlock Text="FreshOut"
                         FontSize="50"
                         FontWeight="ExtraBold"
                         FontFamily="{StaticResource JetBrainsMonoFont}"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,40"
                         Foreground="#475773" />

              <!-- USERNAME -->
              <TextBox Text="{Binding Username, Mode=TwoWay}"
                       PlaceholderText="Enter a cool username"
                       Margin="0,0,0,20"
                       Foreground="#475773" />
              
              <TextBlock Text="{Binding UsernameError}"
                         Foreground="#f54040"
                         FontSize="12"
                         Visibility="{Binding UsernameError, Converter={StaticResource StringToVisibilityConverter}}"
                         Margin="0,0,0,20" />

              <!-- PASSWORD -->
              <PasswordBox Password="{Binding Password, Mode=TwoWay}"
                           PlaceholderText="Enter an unhackable password"
                           Margin="0,0,0,20"
                           Foreground="#475773" />
              <TextBlock Text="{Binding PasswordError}"
                         Foreground="#f54040"
                         FontSize="12"
                         Visibility="{Binding PasswordError, Converter={StaticResource StringToVisibilityConverter}}"
                         Margin="0,0,0,20" />

              <!-- LOGIN BUTTON -->
              <Button Content="Login"
                      AutomationProperties.AutomationId="MainPageButton"
                      Command="{Binding LoginAndGoToMain}"
                      Style="{StaticResource LoginButtonStyle}"
                      HorizontalAlignment="Center"
                      Margin="0,10,0,30" />
              <TextBlock Text="{Binding EmptyInputs}"
                         Foreground="#f54040"
                         FontSize="12"
                         Visibility="{Binding EmptyInputs, Converter={StaticResource  StringToVisibilityConverter}}"
                         Margin="0,0,0,20" />
              <TextBlock Foreground="#f54040"
                         Text="Invalid credentials!"
                         Visibility="{Binding ErrorMessage}"
                         HorizontalAlignment="Center"/>

              <!-- REGISTER BUTTON -->
              <Button Content="Not registered yet? Click here!"
                      AutomationProperties.AutomationId="RegisterPageButton"
                      Command="{Binding GoToRegistration}"
                      Style="{StaticResource RegisterButtonStyle}"
                      HorizontalAlignment="Center"
                      Margin="0"/>
          </StackPanel>
          <Image Source="/Assets/Splash/Grocery.png"
                 Width="840"
                 Height="810"
                 Stretch="UniformToFill"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Viewbox>
</Page>
