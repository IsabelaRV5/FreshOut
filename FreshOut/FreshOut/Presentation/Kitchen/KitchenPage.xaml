<Page x:Class="GUI.Presentation.Kitchen.KitchenPage"
      x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:GUI.Presentation.Kitchen"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material">

    <Viewbox Stretch="Uniform">
        <Grid utu:SafeArea.Insets="VisibleBounds" Background="#aec4e8" Width="1440" Height="810">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <utu:NavigationBar Content="Kitchen"
                               Background="#3a6687"
                               Foreground="#d4ecff"/> 

            <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Background="#fffcf5"
                Padding="10"
                Width="1340"
                Height="730">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="1140"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDE  -->
                    <StackPanel Grid.Column="0" Margin="10">
                        <!--   FreshOut Logo    -->
                        <TextBlock Text="FreshOut" FontSize="50" Foreground="#3a6687" HorizontalAlignment="Center"/>
                        <Line X1="0" X2="1" Stroke="#3a6687" StrokeThickness="1" Stretch="Fill" />

                        <!-- LIST OF LOCATIONS -->
                        <ListView ItemsSource="{Binding LocationLists}"
                            SelectedItem="{Binding SelectedLocation, Mode=TwoWay}" MinHeight="430" MaxHeight="430">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#6caad9" CornerRadius="20" Margin="20">
                                        <TextBlock MaxHeight="50" Text="{Binding Name}" Padding="10" Foreground="#3a6687" FontWeight="Bold" FontSize="28" FontFamily="Arial" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Add location button -->
                        <Button Content="+ Add Location" Click="ShowAddPopupOffsetClicked" HorizontalAlignment="Center" FontSize="25" Padding="15" Margin="0,0,0,15" IsHitTestVisible="{Binding PointerMode}"/>

                        <Line X1="0" X2="1" Stroke="#3a6687" StrokeThickness="1" Stretch="Fill" />
                        <TextBlock Text="Current Date" FontSize="18" Foreground="#3a6687" HorizontalAlignment="Center" Padding="10" Margin="0,15,0,0"/>
                        <TextBlock Text="{Binding CurrentDate}" FontSize="28" Foreground="#3a6687" HorizontalAlignment="Center" Padding="10"/>
                    </StackPanel>

                    <!-- SEPERATION LINE  -->
                    <Line Y1="0" Y2="1" Stroke="#3a6687" StrokeThickness="2" Stretch="Fill" Grid.Column="1"/>

                    <Popup VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           VerticalOffset="100"
                           HorizontalOffset="100"
                           x:Name="AddListPopup" Grid.Column="1">
                        <Border BorderBrush="{StaticResource ApplicationForegroundThemeBrush}" 
                             Background="#fffcf5"
                             Opacity="0.9"
                             BorderThickness="1" Width="500" Height="300"
                             CornerRadius="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                                <TextBlock Text="New name for this location" FontWeight="Bold"  FontSize="23" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="Black"/>
                                <TextBox Text="{Binding NewLocationName, Mode=TwoWay}" PlaceholderText="Enter an awesome name" Margin="0,0,0,20" Background="#fffcf5"/>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="20" Margin="0,0,0,10">
                                    <Button Content="Cancel" Click="CloseAddPopupClicked" Padding="15"/>
                                    <Button Content="Add" Click="AddPopupClicked" Padding="15"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold"  FontSize="16" HorizontalAlignment="Center" Visibility="{Binding AddLocationError}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           VerticalOffset="100"
                           HorizontalOffset="100"
                           x:Name="EditListPopup" Grid.Column="1">
                        <Border BorderBrush="{StaticResource ApplicationForegroundThemeBrush}" 
                             Background="#fffcf5"
                             Opacity="0.9"
                             BorderThickness="1" Width="500" Height="300"
                             CornerRadius="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                                <TextBlock Text="New name for this location" FontWeight="Bold"  FontSize="23" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="Black"/>
                                <TextBox Text="{Binding NewLocationName, Mode=TwoWay}" PlaceholderText="Enter an awesome new name" Margin="0,0,0,20" Background="#fffcf5"/>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="20" Margin="0,0,0,10">
                                    <Button Content="Cancel" Click="CloseEditPopupClicked" Padding="15"/>
                                    <Button Content="Change" Click="ChangePopupClicked" Padding="15"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold"  FontSize="16" HorizontalAlignment="Center" Visibility="{Binding AddLocationError}"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           VerticalOffset="100"
                           HorizontalOffset="100"
                           x:Name="DeleteListPopup" Grid.Column="1">
                        <Border BorderBrush="{StaticResource ApplicationForegroundThemeBrush}" 
                             Background="#f0a6a1"
                             Opacity="0.9"
                             BorderThickness="1" Width="500" Height="300"
                             CornerRadius="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                                <TextBlock Text="Are you sure you want to delete this list with all its items?" FontWeight="Bold"  FontSize="23" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="DarkRed" TextAlignment="Center"/>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="20" Margin="0,30,0,10">
                                    <Button Content="No" Click="CloseConfirmDeleteListPopupClicked" Padding="15" Width="70" Height="60"/>
                                    <Button Content="Yes" Click="DeleteListPopupClicked" Padding="15" Width="70" Height="60"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!--  RIGHT SIDE  -->
                    <StackPanel Grid.Column="2" Margin="10" Width="1100" Height="700">

                        <!--  LOCATION HEADER  -->
                        <Grid Padding="10" Margin="0,0,100,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding SelectedLocation.Name}" Grid.Row="0"  FontSize="40" HorizontalAlignment="Center" Foreground="Black" FontWeight="Bold" FontFamily="Arial"/>
                            <TextBlock Text="Select a location" Grid.Row="0" FontSize="40" HorizontalAlignment="Center" Foreground="Black" FontWeight="Bold" FontFamily="Arial" Visibility="{Binding PlaceholderLocationHeader}"/>
                            <StackPanel Grid.Row="0" Spacing="16" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Content="🗑️" Click="ShowConfirmDeleteListPopupOffsetClicked" Background="white" Style="{StaticResource MaterialFilledButtonStyle}" HorizontalAlignment="Center" FontSize="20" Padding="5" VerticalAlignment="Center" Visibility="{Binding IngredientControls}"/>
                                <Button Content="🖊️" Click="ShowEditPopupOffsetClicked" Background="white" Style="{StaticResource MaterialFilledButtonStyle}" HorizontalAlignment="Center" FontSize="20" Padding="5" VerticalAlignment="Center" Visibility="{Binding IngredientControls}"/>
                            </StackPanel>
                        </Grid>

                        <Line X1="0" X2="1" Stroke="#3a6687" StrokeThickness="2" Stretch="Fill" Margin="0,15,0,0"/>

                        <!--  SEARCH BAR  -->
                        <StackPanel Orientation="Horizontal" Spacing="25" Margin="0,15,0,15">
                            <TextBox
                                    Text="{Binding SearchBox, Mode=TwoWay}"
                                    Width="700"
                                    PlaceholderText="Search"
                                    FontSize="24"
                                    VerticalAlignment="Center"
                                    Foreground="#3a6687"
                                    Background="#93b2c9"
                                    IsHitTestVisible="{Binding PointerMode}"
                                    Visibility="{Binding IngredientControls}"/>
                            
                            <Button Content="Search"
                                    Style="{StaticResource MaterialFilledButtonStyle}"
                                    HorizontalAlignment="Center"
                                    FontSize="23"
                                    Padding="15"
                                    Command="{Binding SearchCommand}"
                                    Visibility="{Binding IngredientControls}"/>
                            
                            <Button Content="Reset"
                                    Style="{StaticResource MaterialFilledButtonStyle}"
                                    HorizontalAlignment="Center"
                                    FontSize="23"
                                    Padding="15"
                                    Command="{Binding ResetListCommand}"
                                    IsHitTestVisible="{Binding PointerMode}"
                                    Visibility="{Binding IngredientControls}"/>
                            
                        </StackPanel>

                        <!-- COLUMN NAMES -->
                        <Grid Padding="12" Background="#d4ecff" Margin="0,0,0,10" Visibility="{Binding IngredientControls}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="185"/>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="350" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Name" FontWeight="Bold" Foreground="#3a6687" FontSize="20" Background="Transparent" Command="{Binding SortByNameCommand}" IsHitTestVisible="{Binding PointerMode}"/>
                            <TextBlock Text="Type" Grid.Column="1" FontWeight="Bold" Foreground="#3a6687" FontSize="20" VerticalAlignment="Center"/>
                            <Button Content="Quantity" Grid.Column="2" FontWeight="Bold" Foreground="#3a6687" FontSize="20" Background="Transparent" Command="{Binding SortByQuantityCommand}" IsHitTestVisible="{Binding PointerMode}"/>
                            <Button Content="Expiration" Grid.Column="3" FontWeight="Bold" Foreground="#3a6687" FontSize="20" Background="Transparent" Command="{Binding SortByDateCommand}" IsHitTestVisible="{Binding PointerMode}"/>
                        </Grid>

                        <!-- LIST OF ITEMS -->
                        <ListView x:Name="ItemsList" ItemsSource="{Binding Items}" MinWidth="1100" MaxWidth="1100" MinHeight="350" MaxHeight="350" HorizontalAlignment="Left">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="320"/>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"  Foreground="#3a6687" FontSize="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Type}" Grid.Column="1" Foreground="#3a6687" FontSize="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Quantity}" Grid.Column="2" Foreground="#3a6687" FontSize="20" VerticalAlignment="Center"/>
                                        <Border Background="{Binding BackgroundColor}" CornerRadius="4" Padding="10,5,10,5" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding ExpirationDate}" Foreground="White" FontSize="20"/>
                                        </Border>
                                        <!-- https://stackoverflow.com/questions/5377690/understand-wpf-binding-commandparameter-binding? -->
                                        <Button Content="🗑️" Command="{Binding DataContext.DeleteOne, ElementName=RootPage}" CommandParameter="{Binding}" Background="white" Style="{StaticResource MaterialFilledButtonStyle}" HorizontalAlignment="Center" FontSize="20" Padding="5" Grid.Column="4" VerticalAlignment="Center"/>
                                        <Button Content="🖊️" Command="{Binding DataContext.GoToEditItem, ElementName=RootPage}" CommandParameter="{Binding}" Background="white" Style="{StaticResource MaterialFilledButtonStyle}" HorizontalAlignment="Center" FontSize="20" Padding="5" Grid.Column="5" VerticalAlignment="Center"/>

                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Line X1="0" X2="1" Stroke="#3a6687" StrokeThickness="2" Stretch="Fill" Margin="0,15,0,0" Visibility="{Binding IngredientControls}"/>

                        <!-- ITEM BUTTON CONTROLS -->
                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" Spacing="50">

                            <!-- ADD NEW ITEM BUTTON-->
                        <Button Content="Add Food Item"
                          AutomationProperties.AutomationId="AddFoodItemButton"
                          Command="{Binding GoToAddFoodItem}"
                          Style="{StaticResource MaterialFilledButtonStyle}"
                          HorizontalAlignment="Center"
                          FontSize="23"
                          Padding="15"
                          Visibility="{Binding IngredientControls}"
                          />
                    <!-- REMOVE ALL SPOILED ITEM BUTTON-->
                        <Button Content="Remove all spoiled items"
                          Command="{Binding DeleteAll}"
                          Style="{StaticResource MaterialFilledButtonStyle}"
                          HorizontalAlignment="Center"
                          FontSize="23"
                          Padding="15"
                          IsHitTestVisible="{Binding PointerMode}"
                          Visibility="{Binding IngredientControls}"
                          />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Viewbox>
</Page>
